# Copy to .env and fill in. .env is gitignored. Every value below is intentionally blank.
# Blank = unset. See README.md for what each variable means.

# --- AI server (all LLM calls go through this) ---
AI_PROVIDER=
AI_SERVER_URL=
AI_SERVER_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=
AI_MAX_RETRIES=
AI_MAX_CONTEXT_TOKENS=
AI_MAX_OUTPUT_TOKENS=
AI_TOOL_MODE=

# --- Separate AI server for the eval judge (unset fields fall back to the AI_* values above) ---
AI_JUDGE_PROVIDER=
AI_JUDGE_SERVER_URL=
AI_JUDGE_SERVER_API_KEY=
AI_JUDGE_MODEL=
AI_JUDGE_REQUEST_TIMEOUT_SECONDS=
AI_JUDGE_MAX_RETRIES=

# --- Privacy: redaction of PII/secrets before any LLM call ---
REDACTION_MODE=
REDACTION_CATEGORIES=

# --- Reviewing recommendation sources before writing (public docs, Jira, Confluence) ---
# REFERENCE_REVIEW: auto (default) | on | off | fixtures. REFERENCE_DOCS_MODE: auto | http | browser.
REFERENCE_REVIEW=
REFERENCE_DOCS_MODE=
# Optional: override the docs platform API base URL (tests, mirror). Blank = the public default.
REFERENCE_DOCS_API=
# Comma-separated hosts that may be fetched. Blank = docs.opswat.com and www.opswat.com only.
REFERENCE_ALLOWED_HOSTS=
REFERENCE_TIMEOUT_SECONDS=
REFERENCE_EXCERPT_CHARS=
# Optional: msedge or chrome, to use an installed browser instead of Playwright's own.
REFERENCE_BROWSER_CHANNEL=
# Atlassian MCP server: its endpoint, the full Authorization header value it expects, and (optionally) the cloud id.
# Blank = Jira and Confluence sources are not opened.
ATLASSIAN_MCP_URL=
ATLASSIAN_MCP_AUTH=
ATLASSIAN_CLOUD_ID=

# --- HTTP API for a web front end ---
# Comma-separated browser origins allowed to call the API (or * for any). Blank = no CORS.
COPILOT_CORS_ORIGINS=
# If set, every /v1 request must send this value in the X-API-Key header. Blank = open.
COPILOT_API_KEY=
