# Copy to .env and fill in. .env is gitignored. Every value below is intentionally blank.
# Blank = unset. See README.md for what each variable means.

# --- AI server (all LLM calls go through this) ---
AI_PROVIDER=
AI_SERVER_URL=
AI_SERVER_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=
AI_MAX_RETRIES=
AI_MAX_CONTEXT_TOKENS=
AI_MAX_OUTPUT_TOKENS=
AI_TOOL_MODE=

# --- Separate AI server for the eval judge (unset fields fall back to the AI_* values above) ---
AI_JUDGE_PROVIDER=
AI_JUDGE_SERVER_URL=
AI_JUDGE_SERVER_API_KEY=
AI_JUDGE_MODEL=
AI_JUDGE_REQUEST_TIMEOUT_SECONDS=
AI_JUDGE_MAX_RETRIES=

# --- Privacy: redaction of PII/secrets before any LLM call ---
REDACTION_MODE=
REDACTION_CATEGORIES=
