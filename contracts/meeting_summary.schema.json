{
  "$defs": {
    "Claim": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "segment_ids": {
          "description": "Transcript segments that support this claim.",
          "items": {
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        },
        "uncertain": {
          "default": false,
          "description": "True if the transcript is ambiguous, noisy or contradictory here.",
          "title": "Uncertain",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "NextAction": {
      "properties": {
        "owner": {
          "enum": [
            "agent",
            "customer",
            "opswat_other"
          ],
          "title": "Owner",
          "type": "string"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "due": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        }
      },
      "required": [
        "owner",
        "action"
      ],
      "title": "NextAction",
      "type": "object"
    },
    "ProductInfo": {
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only a version actually stated in the transcript; never inferred.",
          "title": "Version"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        },
        "uncertain": {
          "default": false,
          "title": "Uncertain",
          "type": "boolean"
        }
      },
      "title": "ProductInfo",
      "type": "object"
    },
    "ThirdPartyComponent": {
      "properties": {
        "name": {
          "description": "Non-OPSWAT product involved in the issue (VDI, proxy, firewall, SSL inspection, other vendor).",
          "title": "Name",
          "type": "string"
        },
        "role": {
          "description": "What it does in the customer's setup / why it matters to the issue.",
          "title": "Role",
          "type": "string"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "role"
      ],
      "title": "ThirdPartyComponent",
      "type": "object"
    }
  },
  "description": "SummaryCore plus fields we fill in deterministically in code.",
  "properties": {
    "plain_language": {
      "description": "2-4 sentence plain-language wrap-up (<=100 words).",
      "title": "Plain Language",
      "type": "string"
    },
    "issue": {
      "$ref": "#/$defs/Claim"
    },
    "product": {
      "$ref": "#/$defs/ProductInfo"
    },
    "steps_taken": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Steps Taken",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Findings",
      "type": "array"
    },
    "next_actions": {
      "items": {
        "$ref": "#/$defs/NextAction"
      },
      "title": "Next Actions",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "third_party_components": {
      "items": {
        "$ref": "#/$defs/ThirdPartyComponent"
      },
      "title": "Third Party Components",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "default": "",
      "title": "Case Id",
      "type": "string"
    },
    "low_confidence_segment_ids": {
      "items": {
        "type": "string"
      },
      "title": "Low Confidence Segment Ids",
      "type": "array"
    },
    "meta": {
      "additionalProperties": true,
      "title": "Meta",
      "type": "object"
    }
  },
  "required": [
    "plain_language",
    "issue",
    "product"
  ],
  "title": "MeetingSummary",
  "type": "object"
}
