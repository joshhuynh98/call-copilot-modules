{
  "$defs": {
    "CallMetadata": {
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "customer_name": {
          "title": "Customer Name",
          "type": "string"
        },
        "customer_contact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Person on the call; used for the email greeting.",
          "title": "Customer Contact"
        },
        "agent_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Name"
        },
        "product": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Product as recorded on the case, if any. May be wrong or missing.",
          "title": "Product"
        },
        "product_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Version"
        },
        "call_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Start"
        },
        "call_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call End"
        }
      },
      "required": [
        "case_id",
        "customer_name"
      ],
      "title": "CallMetadata",
      "type": "object"
    },
    "Claim": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "segment_ids": {
          "description": "Transcript segments that support this claim.",
          "items": {
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        },
        "uncertain": {
          "default": false,
          "description": "True if the transcript is ambiguous, noisy or contradictory here.",
          "title": "Uncertain",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimToVerify": {
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        }
      },
      "required": [
        "claim"
      ],
      "title": "ClaimToVerify",
      "type": "object"
    },
    "EmailDraft": {
      "description": "Always a DRAFT: the agent reviews and edits before sending.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "case_id": {
          "default": "",
          "title": "Case Id",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "body": {
          "description": "Plain text only, signature included.",
          "title": "Body",
          "type": "string"
        },
        "claims_needing_verification": {
          "items": {
            "$ref": "#/$defs/ClaimToVerify"
          },
          "title": "Claims Needing Verification",
          "type": "array"
        },
        "links_used": {
          "items": {
            "type": "string"
          },
          "title": "Links Used",
          "type": "array"
        },
        "warnings": {
          "description": "Auto-fixes we applied or issues the agent should look at.",
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "meta": {
          "additionalProperties": true,
          "title": "Meta",
          "type": "object"
        }
      },
      "required": [
        "subject",
        "body"
      ],
      "title": "EmailDraft",
      "type": "object"
    },
    "EmailOptions": {
      "properties": {
        "allow_meeting_offer": {
          "default": false,
          "description": "Default off: no offering/requesting calls or meetings.",
          "title": "Allow Meeting Offer",
          "type": "boolean"
        },
        "max_words": {
          "default": 150,
          "description": "Target body length, excluding signature.",
          "maximum": 600,
          "minimum": 40,
          "title": "Max Words",
          "type": "integer"
        }
      },
      "title": "EmailOptions",
      "type": "object"
    },
    "GlossaryEntry": {
      "properties": {
        "term": {
          "title": "Term",
          "type": "string"
        },
        "preferred": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wording the agent prefers for this term.",
          "title": "Preferred"
        },
        "avoid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avoid"
        }
      },
      "required": [
        "term"
      ],
      "title": "GlossaryEntry",
      "type": "object"
    },
    "MeetingSummary": {
      "description": "SummaryCore plus fields we fill in deterministically in code.",
      "properties": {
        "issues": {
          "description": "Problems the customer reported, most important first. One short line each.",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Issues",
          "type": "array"
        },
        "product": {
          "$ref": "#/$defs/ProductInfo"
        },
        "before_call": {
          "description": "What was tried or done BEFORE the call.",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Before Call",
          "type": "array"
        },
        "in_call": {
          "description": "What was checked or done DURING the call.",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "In Call",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Findings",
          "type": "array"
        },
        "next_actions": {
          "description": "After the call; owner = agent (support), customer or opswat_other.",
          "items": {
            "$ref": "#/$defs/NextAction"
          },
          "title": "Next Actions",
          "type": "array"
        },
        "open_questions": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Open Questions",
          "type": "array"
        },
        "third_party_components": {
          "items": {
            "$ref": "#/$defs/ThirdPartyComponent"
          },
          "title": "Third Party Components",
          "type": "array"
        },
        "plain_language": {
          "description": "2-3 plain sentences (<=60 words): what happened and what comes next.",
          "title": "Plain Language",
          "type": "string"
        },
        "schema_version": {
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "case_id": {
          "default": "",
          "title": "Case Id",
          "type": "string"
        },
        "recommendation_notes": {
          "items": {
            "$ref": "#/$defs/RecNote"
          },
          "title": "Recommendation Notes",
          "type": "array"
        },
        "low_confidence_segment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Low Confidence Segment Ids",
          "type": "array"
        },
        "meta": {
          "additionalProperties": true,
          "title": "Meta",
          "type": "object"
        }
      },
      "required": [
        "plain_language"
      ],
      "title": "MeetingSummary",
      "type": "object"
    },
    "NextAction": {
      "properties": {
        "owner": {
          "enum": [
            "agent",
            "customer",
            "opswat_other"
          ],
          "title": "Owner",
          "type": "string"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "due": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        }
      },
      "required": [
        "owner",
        "action"
      ],
      "title": "NextAction",
      "type": "object"
    },
    "ProductInfo": {
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only a version actually stated in the transcript; never inferred.",
          "title": "Version"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        },
        "uncertain": {
          "default": false,
          "title": "Uncertain",
          "type": "boolean"
        }
      },
      "title": "ProductInfo",
      "type": "object"
    },
    "RecNote": {
      "description": "Triage of one provided recommendation, made while organising the call.",
      "properties": {
        "rec_id": {
          "title": "Rec Id",
          "type": "string"
        },
        "relevant": {
          "default": true,
          "description": "False for duplicates or items unrelated to this call.",
          "title": "Relevant",
          "type": "boolean"
        },
        "issue": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Index into `issues` this recommendation addresses, if any.",
          "title": "Issue"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "rec_id"
      ],
      "title": "RecNote",
      "type": "object"
    },
    "Recommendation": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rank": {
          "description": "1 = most relevant / likely next step.",
          "title": "Rank",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "action": {
          "description": "One-line action the agent can take now (quality bar: <=120 chars).",
          "title": "Action",
          "type": "string"
        },
        "rationale": {
          "description": "One-to-two-line why (quality bar: <=240 chars).",
          "title": "Rationale",
          "type": "string"
        },
        "sources": {
          "description": "Quality bar: 1-4 sources.",
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "trigger_segment_ids": {
          "description": "Transcript segments that triggered this.",
          "items": {
            "type": "string"
          },
          "title": "Trigger Segment Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "rank",
        "title",
        "action",
        "rationale"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "RecommendationSet": {
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "recommendations": {
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "recommendations"
      ],
      "title": "RecommendationSet",
      "type": "object"
    },
    "Segment": {
      "properties": {
        "id": {
          "description": "Stable segment id, e.g. seg_007. Referenced by recommendations and our claims.",
          "title": "Id",
          "type": "string"
        },
        "speaker": {
          "$ref": "#/$defs/Speaker"
        },
        "start_ms": {
          "default": 0,
          "description": "Milliseconds from call start.",
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "default": 0,
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "text_original": {
          "title": "Text Original",
          "type": "string"
        },
        "text_translated": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "English text; null if the original is already English.",
          "title": "Text Translated"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ASR/translation confidence if known.",
          "title": "Confidence"
        },
        "is_final": {
          "default": true,
          "title": "Is Final",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "speaker",
        "text_original"
      ],
      "title": "Segment",
      "type": "object"
    },
    "Source": {
      "properties": {
        "type": {
          "$ref": "#/$defs/SourceType"
        },
        "label": {
          "description": "Human-readable title of the page/ticket.",
          "title": "Label",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "jira_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jira Key"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        }
      },
      "required": [
        "type",
        "label",
        "url"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "public_doc",
        "internal_kb",
        "confluence",
        "jira",
        "past_case"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "Speaker": {
      "enum": [
        "agent",
        "customer"
      ],
      "title": "Speaker",
      "type": "string"
    },
    "StyleProfile": {
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "tone": {
          "default": "friendly and professional",
          "description": "Free text, e.g. 'warm, direct, no jargon'.",
          "title": "Tone",
          "type": "string"
        },
        "preferred_language": {
          "default": "en",
          "title": "Preferred Language",
          "type": "string"
        },
        "glossary": {
          "items": {
            "$ref": "#/$defs/GlossaryEntry"
          },
          "title": "Glossary",
          "type": "array"
        },
        "sample_emails": {
          "items": {
            "type": "string"
          },
          "title": "Sample Emails",
          "type": "array"
        },
        "signature": {
          "default": "",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "name"
      ],
      "title": "StyleProfile",
      "type": "object"
    },
    "ThirdPartyComponent": {
      "properties": {
        "name": {
          "description": "Non-OPSWAT product involved in the issue (VDI, proxy, firewall, SSL inspection, other vendor).",
          "title": "Name",
          "type": "string"
        },
        "role": {
          "description": "What it does in the customer's setup / why it matters to the issue.",
          "title": "Role",
          "type": "string"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "role"
      ],
      "title": "ThirdPartyComponent",
      "type": "object"
    },
    "Transcript": {
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/CallMetadata"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "metadata",
        "segments"
      ],
      "title": "Transcript",
      "type": "object"
    }
  },
  "description": "Everything the chatbot is grounded in for one meeting.",
  "properties": {
    "transcript": {
      "$ref": "#/$defs/Transcript"
    },
    "recommendations": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecommendationSet"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "style_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/StyleProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "email_options": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmailOptions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeetingSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "email_draft": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmailDraft"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "transcript"
  ],
  "title": "MeetingContext",
  "type": "object"
}
